# Variables de entorno — La Casa de Kuki
# Copiá este archivo como .env y completá los valores reales
# NUNCA commitear .env al repositorio

# WhatsApp Business (número en formato internacional sin +)
# Ejemplo: 5493884616542
WHATSAPP_NUMBER=5493884616542

# URL del sitio en producción (sin barra final)
SITE_URL=https://lacasadekuki.com.ar

# Google Analytics 4 (Measurement ID, formato G-XXXXXXXXXX)
# Se carga solo en producción, vía Partytown (web worker).
# Recordá cargarla también en Vercel → Settings → Environment Variables.
PUBLIC_GA_ID=G-H1NVZK5Z9G

# reCAPTCHA v3 (opcional, para protección adicional del formulario)
# RECAPTCHA_SITE_KEY=tu_clave_aqui
