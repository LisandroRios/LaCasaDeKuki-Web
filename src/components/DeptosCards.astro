---
// DeptosCards — La Casa de Kuki
// Índice visual: dos botones-imagen grandes que dirigen a las páginas de cada departamento

const deptos = [
  {
    id: 'inti',
    name: 'Departamento Inti',
    tagline: 'Hasta 6 personas · Familia o grupo de amigos',
    image: '/images/inti/IMG_3150.PNG',
    href: '/departamentos/inti',
  },
  {
    id: 'killa',
    name: 'Departamento Killa',
    tagline: 'Hasta 4 personas · Pareja o familia chica',
    image: '/images/killa/IMG_3160.PNG',
    href: '/departamentos/killa',
  },
];
---

<section id="departamentos" class="deptos-section">
  <div class="section-wrapper">

    <div class="deptos-header">
      <p class="deptos-eyebrow">Elegí tu espacio</p>
      <h2 class="section-title">Nuestros <em>departamentos</em></h2>
    </div>

    <div class="deptos-grid" role="list">
      {deptos.map((d) => (
        <a
          href={d.href}
          class="depto-btn"
          role="listitem"
          id={`depto-btn-${d.id}`}
          aria-label={`Conocé el ${d.name}`}
        >
          <!-- Imagen de fondo -->
          <img
            src={d.image}
            alt={`Interior del ${d.name} — La Casa de Kuki`}
            class="depto-btn-img"
            loading="lazy"
            decoding="async"
          />

          <!-- Overlay -->
          <div class="depto-btn-overlay" aria-hidden="true"></div>

          <!-- Texto -->
          <div class="depto-btn-content">
            <span class="depto-btn-tagline">{d.tagline}</span>
            <h3 class="depto-btn-name">{d.name}</h3>
            <span class="depto-btn-cta">
              Conocé este depto
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .deptos-section {
    padding: 5rem 0 6rem;
    background-color: var(--color-blanco-calido);
  }

  .deptos-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .deptos-eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-terracota);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-marron-dark);
    text-align: center;
    letter-spacing: -0.01em;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-terracota);
  }

  /* Grid de dos columnas */
  .deptos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  /* Botón-imagen */
  .depto-btn {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 24px rgba(37, 26, 18, 0.1);
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }

  .depto-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(37, 26, 18, 0.2);
  }

  .depto-btn-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    display: block;
  }

  .depto-btn:hover .depto-btn-img {
    transform: scale(1.06);
  }

  /* Overlay: oscuro en reposo, un poco más claro al hover */
  .depto-btn-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(20, 10, 5, 0.80) 0%,
      rgba(20, 10, 5, 0.45) 55%,
      rgba(20, 10, 5, 0.15) 100%
    );
    transition: background 0.35s ease;
  }

  .depto-btn:hover .depto-btn-overlay {
    background: linear-gradient(
      to top,
      rgba(20, 10, 5, 0.70) 0%,
      rgba(20, 10, 5, 0.32) 55%,
      rgba(20, 10, 5, 0.08) 100%
    );
  }

  /* Contenido de texto */
  .depto-btn-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .depto-btn-tagline {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .depto-btn-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
  }

  .depto-btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-arena);
    letter-spacing: 0.03em;
    transition: gap 0.25s ease;
  }

  .depto-btn:hover .depto-btn-cta {
    gap: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .deptos-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .depto-btn {
      aspect-ratio: 4 / 3;
    }

    .depto-btn-content {
      padding: 1.5rem;
    }

    .deptos-section {
      padding: 4rem 0 5rem;
    }
  }
</style>
