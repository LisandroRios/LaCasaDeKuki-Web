---
// Reviews Section — La Casa de Kuki
// Testimonios de huéspedes reales (placeholder realista — reemplazar con reseñas reales de Google)

const reviews = [
  {
    id: 'review-1',
    name: 'María G.',
    origin: 'Buenos Aires',
    rating: 5,
    date: 'Enero 2025',
    text: 'Una experiencia increíble. El lugar es exactamente como lo muestran las fotos, muy limpio y acogedor. Kuki fue una anfitriona excelente, nos dio todos los tips para recorrer la quebrada. El desayuno riquísimo. ¡Volvería sin dudarlo!',
    avatar: 'M',
    avatarColor: '#C1603A',
  },
  {
    id: 'review-2',
    name: 'Lucas P.',
    origin: 'Córdoba',
    rating: 5,
    date: 'Marzo 2025',
    text: 'Llegamos en familia con tres chicos y fue perfecto. El estacionamiento privado es muy útil porque viajamos en auto. La ubicación es imbatible, a pasos de todo. Habitaciones amplias y cómodas. Muy recomendable.',
    avatar: 'L',
    avatarColor: '#7A4B2E',
  },
  {
    id: 'review-3',
    name: 'Sofía V.',
    origin: 'Rosario',
    rating: 5,
    date: 'Julio 2025',
    text: 'El rincón más lindo que encontramos en todo el noroeste. La vista desde el quincho es espectacular. La atención es muy personalizada y cálida. Se nota que hay mucho amor puesto en cada detalle del lugar.',
    avatar: 'S',
    avatarColor: '#9E4C2A',
  },
  {
    id: 'review-4',
    name: 'Roberto & Caro',
    origin: 'Mendoza',
    rating: 5,
    date: 'Agosto 2025',
    text: 'Fue nuestro hospedaje de luna de miel y superó todas las expectativas. El ambiente rústico y cálido, la atención impecable. Nos ayudaron a organizar todas las excursiones. Sin dudas el mejor lugar para hospedarse en Purmamarca.',
    avatar: 'R',
    avatarColor: '#5C3520',
  },
];

const overallRating = 5.0;
const totalReviews = 48;
---

<section id="resenas" class="reviews-section">
  <div class="section-wrapper">
    <!-- Header -->
    <div class="reviews-header">
      <p class="reviews-eyebrow">Lo que dicen nuestros huéspedes</p>
      <h2 class="section-title">Reseñas<br /><em>verificadas</em></h2>
      <div class="section-divider"><span>✦</span></div>

      <!-- Rating overview -->
      <div class="reviews-overview" aria-label={`Puntuación promedio: ${overallRating} sobre 5, basado en ${totalReviews} reseñas`}>
        <div class="overview-score">{overallRating.toFixed(1)}</div>
        <div class="overview-details">
          <div class="overview-stars" role="img" aria-label="5 estrellas">
            {Array.from({ length: 5 }).map(() => (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <p class="overview-count">Basado en <strong>{totalReviews}</strong> reseñas</p>
          <p class="overview-source">Google Maps & Booking.com</p>
        </div>
      </div>
    </div>

    <!-- Cards de reviews -->
    <div class="reviews-grid" role="list">
      {reviews.map((review) => (
        <article class="review-card card" id={review.id} role="listitem">
          <!-- Header de la card -->
          <div class="review-card-header">
            <div class="review-avatar" style={`background-color: ${review.avatarColor}`} aria-hidden="true">
              {review.avatar}
            </div>
            <div class="review-meta">
              <strong class="review-name">{review.name}</strong>
              <span class="review-origin">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                {review.origin}
              </span>
            </div>
            <div class="review-date">{review.date}</div>
          </div>

          <!-- Estrellas -->
          <div class="review-stars" role="img" aria-label={`${review.rating} estrellas`}>
            {Array.from({ length: review.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>

          <!-- Texto -->
          <blockquote class="review-text">
            <span class="review-quote-mark" aria-hidden="true">"</span>
            {review.text}
          </blockquote>

          <!-- Verificado badge -->
          <div class="review-verified" aria-label="Reseña verificada">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
            </svg>
            Huésped verificado
          </div>
        </article>
      ))}
    </div>

    <!-- CTA a Google Maps -->
    <div class="reviews-cta">
      <a
        href="https://www.google.com.ar/maps/place/La+Casa+de+Kuki+Purmamarca/@-23.7484756,-65.4966371,17z"
        target="_blank"
        rel="noopener noreferrer"
        class="reviews-gmaps-btn"
        id="reviews-gmaps-link"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        Ver todas las reseñas en Google Maps
      </a>
    </div>
  </div>
</section>

<script>
  // Animaciones de entrada
  const reviewCards = document.querySelectorAll('.review-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
          }, i * 100);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  reviewCards.forEach(card => {
    (card as HTMLElement).style.opacity = '0';
    (card as HTMLElement).style.transform = 'translateY(24px)';
    (card as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(card);
  });
</script>

<style>
  .reviews-section {
    padding: 6rem 0;
    background: linear-gradient(
      180deg,
      var(--color-blanco-calido) 0%,
      var(--color-arena-light) 100%
    );
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .reviews-eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-terracota);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-terracota);
    display: block;
  }

  /* Overview rating */
  .reviews-overview {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    background: white;
    border-radius: 1.25rem;
    padding: 1.25rem 2rem;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-arena);
    margin-top: 0.5rem;
  }

  .overview-score {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-terracota);
    line-height: 1;
  }

  .overview-details {
    text-align: left;
  }

  .overview-stars {
    display: flex;
    gap: 2px;
    color: #F59E0B;
    margin-bottom: 0.25rem;
  }

  .overview-count {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-carbon);
    margin: 0 0 0.125rem;
  }

  .overview-source {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-carbon-light);
    margin: 0;
  }

  /* Grid */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  /* Review card */
  .review-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid var(--color-arena);
  }

  .review-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .review-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .review-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .review-name {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-carbon);
  }

  .review-origin {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-carbon-light);
  }

  .review-origin svg { color: var(--color-terracota); flex-shrink: 0; }

  .review-date {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-carbon-light);
    white-space: nowrap;
  }

  .review-stars {
    display: flex;
    gap: 2px;
    color: #F59E0B;
  }

  .review-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-carbon-light);
    line-height: 1.7;
    margin: 0;
    position: relative;
    flex: 1;
  }

  .review-quote-mark {
    font-family: var(--font-display);
    font-size: 3.5rem;
    color: var(--color-arena);
    line-height: 0;
    vertical-align: -0.75rem;
    margin-right: 0.25rem;
    float: left;
    font-style: italic;
  }

  .review-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: #16A34A;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* CTA */
  .reviews-cta {
    text-align: center;
  }

  .reviews-gmaps-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background-color: white;
    color: var(--color-marron);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    border: 2px solid var(--color-arena);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-card);
  }

  .reviews-gmaps-btn:hover {
    background-color: var(--color-terracota);
    color: white;
    border-color: var(--color-terracota);
    transform: translateY(-2px);
    box-shadow: var(--shadow-warm);
  }

  .reviews-gmaps-btn svg { flex-shrink: 0; }

  /* Responsive */
  @media (max-width: 768px) {
    .reviews-grid { grid-template-columns: 1fr; }
    .reviews-overview { flex-direction: column; gap: 0.75rem; text-align: center; }
    .overview-details { text-align: center; }
    .overview-stars { justify-content: center; }
  }
</style>
