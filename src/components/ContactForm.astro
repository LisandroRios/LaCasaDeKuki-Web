---
// ContactForm — La Casa de Kuki (V2)
// Motor de disponibilidad y cotizador en vivo
// Resultados presentados en Modal superpuesto (Overlay) minimalista

const whatsappNumber = '5493884616542';
---

<section id="contacto" class="contact-section">
  <!-- Fondo decorativo -->
  <div class="contact-bg" aria-hidden="true">
    <div class="contact-bg-pattern"></div>
  </div>

  <div class="section-wrapper contact-wrapper">
    <!-- Col izquierda: info -->
    <div class="contact-info">
      <div class="contact-header">
        <p class="contact-eyebrow">¿Venís a Purmamarca?</p>
        <h2 class="contact-title">Consultar<br /><em>disponibilidad</em></h2>
        <p class="contact-description">
          Ingresá tus fechas y cantidad de huéspedes para conocer al instante las opciones disponibles y tarifas exactas.
        </p>
      </div>

      <!-- Info rápida -->
      <div class="contact-quick-info">
        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/>
            </svg>
          </div>
          <div>
            <strong>WhatsApp directo</strong>
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="quick-info-link">
              +54 9 3884 616542
            </a>
          </div>
        </div>

        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
          <div>
            <strong>Ubicación</strong>
            <a
              href="https://www.google.com.ar/maps/place/La+Casa+de+Kuki+Purmamarca/@-23.7484756,-65.4966371,17z/data=!4m9!3m8!1s0x941b49429382b9a1:0x940dd8cb5206f489!5m2!4m1!1i2!8m2!3d-23.7484756!4d-65.4966371!16s%2Fg%2F11tt5xrsqn?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="quick-info-link"
            >
              Purmamarca, Jujuy
            </a>
          </div>
        </div>

        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
            </svg>
          </div>
          <div>
            <strong>Horarios</strong>
            <span class="quick-info-text">Check-in 14:00 / Check-out 12:00 hs</span>
          </div>
        </div>

        <!-- Google reviews -->
        <div class="quick-info-item">
          <div class="quick-info-icon quick-info-icon--google">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#EA4335" d="M5.266 9.765A7.077 7.077 0 0 1 12 4.909c1.69 0 3.218.6 4.418 1.582L19.91 3C17.782 1.145 15.055 0 12 0 7.27 0 3.198 2.698 1.24 6.65l4.026 3.115z"/>
              <path fill="#34A853" d="M16.04 18.013c-1.09.703-2.474 1.078-4.04 1.078a7.077 7.077 0 0 1-6.723-4.823l-4.04 3.067A11.965 11.965 0 0 0 12 24c2.933 0 5.735-1.043 7.834-3l-3.793-2.987z"/>
              <path fill="#4A90D9" d="M19.834 21c2.195-2.048 3.62-5.096 3.62-9 0-.71-.109-1.473-.272-2.182H12v4.637h6.436c-.317 1.559-1.17 2.766-2.395 3.558L19.834 21z"/>
              <path fill="#FBBC05" d="M5.277 14.268A7.12 7.12 0 0 1 4.909 12c0-.782.125-1.533.357-2.235L1.24 6.65A11.934 11.934 0 0 0 0 12c0 1.92.445 3.73 1.237 5.335l4.04-3.067z"/>
            </svg>
          </div>
          <div>
            <strong>Google Reviews</strong>
            <a
              href="https://www.google.com.ar/maps/place/La+Casa+de+Kuki+Purmamarca/@-23.7484756,-65.4966371,17z/data=!4m9!3m8!1s0x941b49429382b9a1:0x940dd8cb5206f489!5m2!4m1!1i2!8m2!3d-23.7484756!4d-65.4966371!16s%2Fg%2F11tt5xrsqn?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="quick-info-link google-reviews-link"
              id="contact-google-reviews-link"
              aria-label="Ver 119 reseñas de La Casa de Kuki en Google"
            >
              <span class="google-stars" aria-hidden="true">★★★★★</span>
              <span>4.7 &bull; 119 reseñas</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Col derecha: formulario -->
    <div class="contact-form-wrap">
      <form
        id="contact-form"
        class="contact-form"
        novalidate
        aria-label="Formulario de consulta de disponibilidad y cotización"
      >
        <!-- Honeypot anti-spam -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">Sitio web (no completar)</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-group">
          <label class="form-label" for="nombre">Tu nombre completo <span class="required" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            class="form-input"
            placeholder="Ej: María García"
            required
            minlength="2"
            maxlength="80"
            autocomplete="name"
            aria-required="true"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="huespedes">Cantidad de huéspedes <span class="required" aria-hidden="true">*</span></label>
          <select
            id="huespedes"
            name="huespedes"
            class="form-input"
            required
            aria-required="true"
          >
            <option value="">Seleccioná la cantidad</option>
            <option value="1">1 persona</option>
            <option value="2">2 personas</option>
            <option value="3">3 personas</option>
            <option value="4">4 personas</option>
            <option value="5">5 personas</option>
            <option value="6">6 personas</option>
            <option value="7">7 personas (Complejo Completo)</option>
            <option value="8">8 personas (Complejo Completo)</option>
            <option value="9">9 personas (Complejo Completo)</option>
            <option value="10">10 personas (Complejo Completo)</option>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="ingreso">Fecha de ingreso <span class="required" aria-hidden="true">*</span></label>
            <input
              type="date"
              id="ingreso"
              name="ingreso"
              class="form-input"
              required
              aria-required="true"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="egreso">Fecha de egreso <span class="required" aria-hidden="true">*</span></label>
            <input
              type="date"
              id="egreso"
              name="egreso"
              class="form-input"
              required
              aria-required="true"
            />
          </div>
        </div>

        <!-- Error message -->
        <div id="form-error" class="form-error" role="alert" aria-live="polite" hidden></div>

        <!-- Botón de consulta -->
        <button type="submit" class="btn-primary form-submit" id="form-submit-btn">
          <svg class="submit-icon w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="btn-text">Consultar disponibilidad</span>
        </button>

        <p class="form-privacy">
          <svg class="w-3 h-3 shrink-0 inline-block align-middle mr-1 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
          </svg>
          Verificación directa en nuestros calendarios oficiales. Sin comisiones.
        </p>
      </form>
    </div>
  </div>
</section>

<!-- =============================================
     MODAL SUPERPUESTO (OVERLAY) DE RESULTADOS
     ============================================= -->
<div
  id="availability-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-summary-title"
>
  <div
    class="bg-[#FDFBF7] rounded-2xl p-6 md:p-8 max-w-3xl w-full shadow-2xl relative max-h-[90vh] overflow-y-auto transform scale-95 transition-all duration-300 border border-[#E0C990]/30"
    id="modal-card-container"
  >
    <!-- Botón Cerrar (X) -->
    <button
      type="button"
      id="modal-close-btn"
      class="absolute top-4 right-4 md:top-6 md:right-6 text-[#4E3820] hover:text-[#C85A32] p-2 rounded-full hover:bg-black/5 transition cursor-pointer z-10"
      aria-label="Cerrar ventana de resultados"
    >
      <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Encabezado con resumen de búsqueda -->
    <div id="modal-header-content" class="pr-8 mb-6 border-b border-[#8C5230]/15 pb-5">
      <!-- Inyectado dinámicamente -->
    </div>

    <!-- Contenedor de las tarjetas de resultados -->
    <div id="modal-results-body">
      <!-- Inyectado dinámicamente -->
    </div>
  </div>
</div>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');
  const submitBtn = document.getElementById('form-submit-btn');
  const nombreInput = document.getElementById('nombre');
  const huespedesInput = document.getElementById('huespedes');
  const ingresoInput = document.getElementById('ingreso');
  const egresoInput = document.getElementById('egreso');

  // Modal elements
  const modal = document.getElementById('availability-modal');
  const modalContainer = document.getElementById('modal-card-container');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalHeaderContent = document.getElementById('modal-header-content');
  const modalResultsBody = document.getElementById('modal-results-body');

  // Sanitización básica XSS
  function sanitize(str) {
    return String(str)
      .trim()
      .replace(/[<>&"'`]/g, (c) => ({
        '<': '&lt;', '>': '&gt;', '&': '&amp;',
        '"': '&quot;', "'": '&#x27;', '`': '&#x60;'
      })[c] || c)
      .substring(0, 500);
  }

  // Obtener fecha local de hoy en formato YYYY-MM-DD
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

  // Fijar fecha máxima: fin del semestre actual
  const currentMonth = now.getMonth();
  const currentYear = now.getFullYear();
  const maxDate = currentMonth < 6
    ? `${currentYear}-06-30`
    : `${currentYear}-12-31`;

  if (ingresoInput) {
    ingresoInput.setAttribute('min', today);
    ingresoInput.setAttribute('max', maxDate);
  }
  if (egresoInput) {
    egresoInput.setAttribute('min', today);
    egresoInput.setAttribute('max', maxDate);
  }

  function getNextDay(dateStr) {
    if (!dateStr) return today;
    const [y, m, d] = dateStr.split('-').map(Number);
    const date = new Date(Date.UTC(y, m - 1, d));
    date.setUTCDate(date.getUTCDate() + 1);
    return date.toISOString().split('T')[0];
  }

  ingresoInput?.addEventListener('change', () => {
    if (ingresoInput.value) {
      const minEgreso = getNextDay(ingresoInput.value);
      if (egresoInput) {
        egresoInput.setAttribute('min', minEgreso);
        if (egresoInput.value && egresoInput.value <= ingresoInput.value) {
          egresoInput.value = minEgreso;
        }
      }
    }
  });

  function showError(msg) {
    if (!errorDiv) return;
    errorDiv.textContent = msg;
    errorDiv.hidden = false;
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideError() {
    if (!errorDiv) return;
    errorDiv.hidden = true;
    errorDiv.textContent = '';
  }

  function setLoading(isLoading) {
    if (!submitBtn) return;
    if (isLoading) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('is-loading');
      submitBtn.innerHTML = `
        <span class="spinner-icon shrink-0" aria-hidden="true"></span>
        <span class="btn-text">Verificando disponibilidad en tiempo real...</span>
      `;
    } else {
      submitBtn.removeAttribute('disabled');
      submitBtn.classList.remove('is-loading');
      submitBtn.innerHTML = `
        <svg class="submit-icon w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="btn-text">Consultar disponibilidad</span>
      `;
    }
  }

  function formatMoney(amount) {
    return '$' + Math.round(amount).toLocaleString('es-AR');
  }

  // Apertura y cierre del modal
  function openModal() {
    if (!modal || !modalContainer) return;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalContainer.classList.remove('scale-95');
    modalContainer.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalContainer) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalContainer.classList.remove('scale-100');
    modalContainer.classList.add('scale-95');
    document.body.style.overflow = '';
  }

  modalCloseBtn?.addEventListener('click', closeModal);

  // Cerrar al hacer clic en el backdrop fuera del contenedor
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
      closeModal();
    }
  });

  // Renderizar contenido minimalista dentro del modal
  function renderModalResults(data) {
    if (!modalHeaderContent || !modalResultsBody) return;

    const { scenario, checkInFormatted, checkOutFormatted, nightsCount, nightsText, huespedesText, options, specialInfo } = data;

    // Encabezado del modal
    modalHeaderContent.innerHTML = `
      <div class="flex flex-col gap-1.5">
        <span class="text-xs font-bold uppercase tracking-wider text-[#C85A32]">La Casa de Kuki · Purmamarca</span>
        <h3 id="modal-summary-title" class="font-serif text-2xl md:text-3xl font-bold text-[#613822] leading-tight">
          ${scenario === 'A' ? 'Opciones disponibles para tu estadía' : 'Información de tu consulta'}
        </h3>
        <div class="flex flex-wrap items-center gap-2 mt-1 text-xs md:text-sm text-[#4E3820]">
          <span class="inline-flex items-center gap-1.5 bg-[#EFE5C8]/80 px-2.5 py-1 rounded-md font-medium text-[#4E3820]">
            📅 <strong>${checkInFormatted}</strong> al <strong>${checkOutFormatted}</strong> (${nightsText})
          </span>
          <span class="inline-flex items-center gap-1.5 bg-[#EFE5C8]/80 px-2.5 py-1 rounded-md font-medium text-[#4E3820]">
            👥 <strong>${huespedesText}</strong>
          </span>
        </div>
      </div>
    `;

    // SVG estándar de WhatsApp con clases fijas
    const whatsappIconSvg = `
      <svg class="w-5 h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/>
      </svg>
    `;

    let html = '';

    // ESCENARIO A: Días normales con disponibilidad (1 o 2 departamentos)
    if (scenario === 'A' && options && options.length > 0) {
      const isDual = options.length === 2;
      const gridClass = isDual ? 'grid grid-cols-1 md:grid-cols-2 gap-6' : 'max-w-md mx-auto';

      html += `<div class="${gridClass}">`;

      options.forEach((opt) => {
        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(opt.whatsappMessage)}`;
        const deptoFullName = opt.id === 'inti' ? 'Departamento Inti' : 'Departamento Killa';
        const capacitySub = opt.id === 'inti' ? 'Capacidad hasta 6 personas' : 'Capacidad hasta 4 personas';

        html += `
          <div class="result-card-minimal bg-white border border-[#8C5230]/20 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Disponible
                </span>
              </div>

              <h4 class="font-serif text-2xl font-bold text-[#613822] mb-1">${deptoFullName}</h4>
              <p class="text-sm text-[#4E3820]/80 mb-5">${capacitySub}</p>

              <!-- Caja de precios limpia -->
              <div class="bg-[#FAF6F0] border border-[#8C5230]/15 rounded-xl p-4 my-3 flex flex-col gap-2">
                <div class="flex justify-between items-baseline text-sm text-[#4E3820]">
                  <span>Precio por noche:</span>
                  <span class="font-semibold text-[#221610]">${formatMoney(opt.pricePerNight)}</span>
                </div>
                <div class="flex justify-between items-baseline pt-2 border-t border-[#8C5230]/15">
                  <span class="text-sm font-semibold text-[#221610]">Total por ${nightsText}:</span>
                  <span class="font-serif text-2xl font-bold text-[#C85A32]">${formatMoney(opt.total)}</span>
                </div>
              </div>
            </div>

            <!-- Botón CTA WhatsApp -->
            <a
              href="${waUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-whatsapp-cta w-full bg-[#C85A32] hover:bg-[#B04B25] text-white font-medium py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition cursor-pointer mt-4 text-center shadow-sm hover:shadow-md"
              data-depto="${opt.id}"
            >
              ${whatsappIconSvg}
              <span>${opt.ctaText}</span>
            </a>
          </div>
        `;
      });

      html += `</div>`;
    }

    // ESCENARIOS B, C, D (Tarjeta única centrada)
    if (specialInfo) {
      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(specialInfo.whatsappMessage)}`;
      const badgeStyle =
        scenario === 'B' ? 'bg-amber-50 text-amber-800 border-amber-200' :
        scenario === 'C' ? 'bg-orange-50 text-orange-800 border-orange-200' :
        'bg-stone-100 text-stone-700 border-stone-300';

      html += `
        <div class="max-w-md mx-auto bg-white border border-[#8C5230]/20 rounded-2xl p-6 md:p-8 text-center shadow-sm flex flex-col items-center gap-3">
          <span class="inline-flex items-center text-xs font-semibold px-3 py-1 rounded-full border ${badgeStyle}">
            ${specialInfo.badge}
          </span>
          <h4 class="font-serif text-2xl font-bold text-[#613822] leading-snug">
            ${specialInfo.title}
          </h4>
          <p class="text-sm text-[#4E3820] leading-relaxed mb-3">
            ${specialInfo.description}
          </p>
          <a
            href="${waUrl}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp-cta w-full bg-[#C85A32] hover:bg-[#B04B25] text-white font-medium py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition cursor-pointer text-center shadow-sm hover:shadow-md"
          >
            ${whatsappIconSvg}
            <span>${specialInfo.ctaText}</span>
          </a>
        </div>
      `;
    }

    modalResultsBody.innerHTML = html;

    // Eventos GA4
    modalResultsBody.querySelectorAll('.btn-whatsapp-cta').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', {
            event_category: 'contact',
            event_label: `quote_whatsapp_scenario_${scenario}`
          });
        }
      });
    });

    // Abrir modal
    openModal();
  }

  // Submit del formulario
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const honeypot = (document.getElementById('website')).value;
    if (honeypot) return;

    const nombre = sanitize(nombreInput?.value || '');
    const huespedes = parseInt(sanitize(huespedesInput?.value || ''), 10);
    const ingreso = sanitize(ingresoInput?.value || '');
    const egreso = sanitize(egresoInput?.value || '');

    if (nombre.length < 2) {
      showError('Por favor, ingresá tu nombre completo (mínimo 2 caracteres).');
      nombreInput?.focus();
      return;
    }

    if (!huespedes || isNaN(huespedes) || huespedes < 1 || huespedes > 10) {
      showError('Por favor, seleccioná la cantidad de huéspedes (entre 1 y 10 personas).');
      huespedesInput?.focus();
      return;
    }

    if (!ingreso || !egreso) {
      showError('Por favor, seleccioná las fechas de ingreso y egreso.');
      return;
    }

    if (ingreso < today) {
      showError('La fecha de ingreso no puede ser anterior a hoy.');
      return;
    }

    if (egreso <= ingreso) {
      showError('La fecha de egreso debe ser posterior a la fecha de ingreso (mínimo 1 noche).');
      return;
    }

    if (egreso > maxDate) {
      const [maxY, maxM, maxD] = maxDate.split('-');
      showError(`Las fechas deben estar dentro del semestre en curso (hasta el ${maxD}/${maxM}/${maxY}). Para fechas posteriores consultanos directo.`);
      return;
    }

    setLoading(true);

    try {
      const res = await fetch('/api/disponibilidad', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          nombre,
          huespedes,
          ingreso,
          egreso
        })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || 'No pudimos verificar la disponibilidad en este momento.');
      }

      renderModalResults(data);

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'check_availability', {
          event_category: 'availability_engine',
          event_label: `scenario_${data.scenario}`,
          value: data.nightsCount
        });
      }
    } catch (err) {
      console.error('Error al consultar disponibilidad:', err);
      showError(err.message || 'Ocurrió un error al consultar el sistema. Por favor, intentá nuevamente o contactanos directamente por WhatsApp.');
    } finally {
      setLoading(false);
    }
  });
</script>

