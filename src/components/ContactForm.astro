---
// ContactForm — La Casa de Kuki
// Formulario de consulta → redirige a WhatsApp Business con mensaje preformateado
// Seguridad: Honeypot anti-spam + sanitización client-side + validación HTML5

const whatsappNumber = '5493884616542';
// Mensaje base (las fechas y personas se insertan dinámicamente desde el form)
const whatsappBaseMessage = '¡Hola! Vi la web de La Casa de Kuki y quiero consultar disponibilidad para alojarme del [] al [] para [___] personas. ¡Gracias!';
---

<section id="contacto" class="contact-section">
  <!-- Fondo decorativo -->
  <div class="contact-bg" aria-hidden="true">
    <div class="contact-bg-pattern"></div>
  </div>

  <div class="section-wrapper contact-wrapper">
    <!-- Col izquierda: info -->
    <div class="contact-info">
      <div class="contact-header">
        <p class="contact-eyebrow">¿Venís a Purmamarca?</p>
        <h2 class="contact-title">Consultar<br /><em>disponibilidad</em></h2>
        <p class="contact-description">
          Contanos en qué fechas venís y te confirmamos por WhatsApp.
        </p>
      </div>

      <!-- Info rápida -->
      <div class="contact-quick-info">
        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/>
            </svg>
          </div>
          <div>
            <strong>WhatsApp</strong>
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="quick-info-link">
              +54 9 3884 616542
            </a>
          </div>
        </div>

        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </div>
          <div>
            <strong>Ubicación</strong>
            <a
              href="https://www.google.com.ar/maps/place/La+Casa+de+Kuki+Purmamarca/@-23.7484756,-65.4966371,17z/data=!4m9!3m8!1s0x941b49429382b9a1:0x940dd8cb5206f489!5m2!4m1!1i2!8m2!3d-23.7484756!4d-65.4966371!16s%2Fg%2F11tt5xrsqn?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="quick-info-link"
            >
              Purmamarca, Jujuy
            </a>
          </div>
        </div>

        <div class="quick-info-item">
          <div class="quick-info-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
            </svg>
          </div>
          <div>
            <strong>Check-in / Check-out</strong>
            <span class="quick-info-text">14:00 / 12:00 hs</span>
          </div>
        </div>

        <!-- Prueba social: Google reviews -->
        <div class="quick-info-item">
          <div class="quick-info-icon quick-info-icon--google">
            <!-- Google «G» multicolor -->
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#EA4335" d="M5.266 9.765A7.077 7.077 0 0 1 12 4.909c1.69 0 3.218.6 4.418 1.582L19.91 3C17.782 1.145 15.055 0 12 0 7.27 0 3.198 2.698 1.24 6.65l4.026 3.115z"/>
              <path fill="#34A853" d="M16.04 18.013c-1.09.703-2.474 1.078-4.04 1.078a7.077 7.077 0 0 1-6.723-4.823l-4.04 3.067A11.965 11.965 0 0 0 12 24c2.933 0 5.735-1.043 7.834-3l-3.793-2.987z"/>
              <path fill="#4A90D9" d="M19.834 21c2.195-2.048 3.62-5.096 3.62-9 0-.71-.109-1.473-.272-2.182H12v4.637h6.436c-.317 1.559-1.17 2.766-2.395 3.558L19.834 21z"/>
              <path fill="#FBBC05" d="M5.277 14.268A7.12 7.12 0 0 1 4.909 12c0-.782.125-1.533.357-2.235L1.24 6.65A11.934 11.934 0 0 0 0 12c0 1.92.445 3.73 1.237 5.335l4.04-3.067z"/>
            </svg>
          </div>
          <div>
            <strong>Google Reviews</strong>
            <a
              href="https://www.google.com.ar/maps/place/La+Casa+de+Kuki+Purmamarca/@-23.7484756,-65.4966371,17z/data=!4m9!3m8!1s0x941b49429382b9a1:0x940dd8cb5206f489!5m2!4m1!1i2!8m2!3d-23.7484756!4d-65.4966371!16s%2Fg%2F11tt5xrsqn?entry=ttu&g_ep=EgoyMDI2MDgwNS4xIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="quick-info-link google-reviews-link"
              id="contact-google-reviews-link"
              aria-label="Ver 112 reseñas de La Casa de Kuki en Google"
            >
              <span class="google-stars" aria-hidden="true">★★★★★</span>
              <span>4.7 &bull; 112 reseñas</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Col derecha: formulario -->
    <div class="contact-form-wrap">
      <form
        id="contact-form"
        class="contact-form"
        novalidate
        aria-label="Formulario de consulta de disponibilidad"
      >
        <!-- Honeypot anti-spam (campo oculto, bots lo llenan, humanos no) -->
        <div class="hp-field" aria-hidden="true">
          <label for="website">Sitio web (no completar)</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-group">
            <label class="form-label" for="nombre">Nombre completo <span class="required" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              class="form-input"
              placeholder="Ej: María García"
              required
              minlength="2"
              maxlength="80"
              autocomplete="name"
              aria-required="true"
            />
          </div>

        <div class="form-group">
          <label class="form-label" for="huespedes">Cantidad de huéspedes <span class="required" aria-hidden="true">*</span></label>
          <select
            id="huespedes"
            name="huespedes"
            class="form-input"
            required
            aria-required="true"
          >
            <option value="">Seleccioná la cantidad</option>
            <option value="1">1 persona</option>
            <option value="2">2 personas</option>
            <option value="3">3 personas</option>
            <option value="4">4 personas</option>
            <option value="5">5 personas</option>
            <option value="6">6 personas</option>
            <option value="7+">7 o más personas</option>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="ingreso">Fecha de ingreso <span class="required" aria-hidden="true">*</span></label>
            <input
              type="date"
              id="ingreso"
              name="ingreso"
              class="form-input"
              required
              aria-required="true"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="egreso">Fecha de egreso <span class="required" aria-hidden="true">*</span></label>
            <input
              type="date"
              id="egreso"
              name="egreso"
              class="form-input"
              required
              aria-required="true"
            />
          </div>
        </div>


        <!-- Error message -->
        <div id="form-error" class="form-error" role="alert" aria-live="polite" hidden></div>

        <button type="submit" class="btn-primary form-submit" id="form-submit-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/>
          </svg>
          Enviar consulta por WhatsApp
        </button>

        <p class="form-privacy">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:middle;margin-right:0.3rem">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
          </svg>
          Tus datos son usados únicamente para responder tu consulta. No spam.
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById('contact-form');
  const errorDiv = document.getElementById('form-error');
  const submitBtn = document.getElementById('form-submit-btn');

  // Sanitización básica XSS
  function sanitize(str) {
    return String(str)
      .trim()
      .replace(/[<>&"'`]/g, (c) => ({
        '<': '&lt;', '>': '&gt;', '&': '&amp;',
        '"': '&quot;', "'": '&#x27;', '`': '&#x60;'
      })[c] || c)
      .substring(0, 500);
  }

  // Fechas: ingreso debe ser antes que egreso y ambas dentro del semestre
  function isValidDates(ingreso, egreso, maxDate) {
    const ingresoDate = new Date(ingreso);
    const egresoDate = new Date(egreso);
    const maxAllowed = new Date(maxDate);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    return ingresoDate >= today && egresoDate > ingresoDate && egresoDate <= maxAllowed;
  }

  function showError(msg) {
    if (!errorDiv) return;
    errorDiv.textContent = msg;
    errorDiv.hidden = false;
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideError() {
    if (!errorDiv) return;
    errorDiv.hidden = true;
    errorDiv.textContent = '';
  }

  // Fijar fecha mínima de hoy
  const today = new Date().toISOString().split('T')[0];
  const ingresoInput = document.getElementById('ingreso');
  const egresoInput = document.getElementById('egreso');
  if (ingresoInput) ingresoInput.setAttribute('min', today);
  if (egresoInput) egresoInput.setAttribute('min', today);
  ingresoInput?.addEventListener('change', () => {
    if (egresoInput) egresoInput.setAttribute('min', (ingresoInput).value || today);
  });

  // Fijar fecha máxima: fin del semestre actual
  // Enero–Junio → 30/06 | Julio–Diciembre → 31/12
  // Actualizar cada semestre para abrir nuevas disponibilidades con precios actualizados.
  const nowForMax = new Date();
  const currentMonth = nowForMax.getMonth(); // 0-indexed (0=enero, 11=diciembre)
  const currentYear = nowForMax.getFullYear();
  const maxDate = currentMonth < 6
    ? `${currentYear}-06-30`   // primer semestre
    : `${currentYear}-12-31`;  // segundo semestre
  if (ingresoInput) ingresoInput.setAttribute('max', maxDate);
  if (egresoInput) egresoInput.setAttribute('max', maxDate);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    hideError();

    // Verificar honeypot (anti-spam)
    const honeypot = (document.getElementById('website')).value;
    if (honeypot) return;

    // Obtener y sanitizar valores
    const nombre = sanitize((document.getElementById('nombre')).value);
    const huespedes = sanitize((document.getElementById('huespedes')).value);
    const ingreso = sanitize((document.getElementById('ingreso')).value);
    const egreso = sanitize((document.getElementById('egreso')).value);

    // Validaciones
    if (nombre.length < 2) {
      showError('Por favor, ingresá tu nombre completo (mínimo 2 caracteres).');
      document.getElementById('nombre')?.focus();
      return;
    }

    if (!huespedes) {
      showError('Por favor, seleccioná la cantidad de huéspedes.');
      document.getElementById('huespedes')?.focus();
      return;
    }

    if (!ingreso || !egreso) {
      showError('Por favor, seleccioná las fechas de ingreso y egreso.');
      return;
    }

    if (!isValidDates(ingreso, egreso, maxDate)) {
      const [maxY, maxM, maxD] = maxDate.split('-');
      showError(`Las fechas no son válidas. El ingreso debe ser hoy o posterior, el egreso debe ser después del ingreso, y ambas fechas deben estar dentro del semestre actual (hasta el ${maxD}/${maxM}/${maxY}).`);
      return;
    }

    // Construir mensaje WhatsApp
    const formatDate = (dateStr) => {
      const [y, m, d] = dateStr.split('-');
      return `${d}/${m}/${y}`;
    };

    const nights = Math.round(
      (new Date(egreso) - new Date(ingreso)) / (1000 * 60 * 60 * 24)
    );

    const huespedesTexto = huespedes === '1' ? '1 persona' : huespedes === '7+' ? '7 o más personas' : `${huespedes} personas`;

    const waMessage = [
      `¡Hola! Me comunico desde el sitio web de La Casa de Kuki.`,
      ``,
      `*Datos de consulta:*`,
      `- Nombre: ${nombre}`,
      `- Huéspedes: ${huespedesTexto}`,
      `- Ingreso: ${formatDate(ingreso)}`,
      `- Egreso: ${formatDate(egreso)} (${nights} noche${nights !== 1 ? 's' : ''})`,
      ``,
      `¿Tienen disponibilidad? ¡Gracias!`,
    ].join('\n');

    const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waMessage)}`;

    // Feedback visual
    if (submitBtn) {
      submitBtn.textContent = 'Redirigiendo a WhatsApp...';
      submitBtn.setAttribute('disabled', 'true');
    }

    setTimeout(() => {
      window.open(waUrl, '_blank', 'noopener,noreferrer');
      if (submitBtn) {
        submitBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/></svg> Enviar consulta por WhatsApp`;
        submitBtn.removeAttribute('disabled');
      }
    }, 400);
  });
</script>

<style>
  .contact-section {
    padding: 6rem 0;
    background-color: var(--color-marron-dark);
    background-image:
      radial-gradient(ellipse at 15% 50%, rgba(192, 85, 53, 0.22) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 15%, rgba(224, 201, 144, 0.08) 0%, transparent 40%),
      var(--texture-adobe-dark);
    position: relative;
    overflow: hidden;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .contact-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(193, 96, 58, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(232, 213, 176, 0.1) 0%, transparent 40%);
  }

  .contact-wrapper {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Info column */
  .contact-info {
    color: white;
    padding-top: 2rem;
  }

  .contact-eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-arena);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700;
    color: white;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .contact-title em {
    font-style: italic;
    color: var(--color-arena);
    display: block;
  }

  .contact-description {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .contact-quick-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quick-info-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .quick-info-icon {
    width: 44px;
    height: 44px;
    background: rgba(255,255,255,0.1);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-arena);
    flex-shrink: 0;
  }

  .quick-info-item > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .quick-info-item strong {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .quick-info-link {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-arena);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .quick-info-link:hover { color: white; text-decoration: underline; }

  .quick-info-text {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    font-weight: 600;
  }

  /* Google reviews trust item */
  .quick-info-icon--google {
    background: rgba(255,255,255,0.12);
  }

  .google-reviews-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .google-stars {
    color: #F59E0B;
    font-size: 1rem;
    letter-spacing: -1px;
  }

  /* Formulario */
  .contact-form-wrap {
    background: var(--color-blanco-calido);
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Honeypot — visualmente oculto pero accesible para bots */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
