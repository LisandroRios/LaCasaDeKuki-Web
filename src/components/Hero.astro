---
// Hero Section — La Casa de Kuki
const whatsappNumber = '5493884616542';
const whatsappMessage = encodeURIComponent('¡Hola! Me gustaría obtener información sobre el hospedaje La Casa de Kuki en Purmamarca. ¿Tienen disponibilidad?');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section id="inicio" class="hero">
  <!-- Imagen de fondo -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/exterior/1000472082.JPG"
      alt=""
      class="hero-bg-img"
      fetchpriority="high"
      width="1920"
      height="1080"
      role="presentation"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Contenido centrado -->
  <div class="hero-content">
    <!-- Badge de ubicación -->
    <div class="hero-badge animate-fadeUp animate-delay-200">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      Purmamarca, Jujuy · Argentina
    </div>

    <!-- H1 máximo 5 palabras -->
    <h1 class="hero-title animate-fadeUp animate-delay-400">
      Tu hogar en<br /><em>la Quebrada</em>
    </h1>

    <!-- CTA único -->
    <a
      href="#contacto"
      class="btn-primary hero-btn animate-fadeUp animate-delay-600"
      id="hero-cta-reserva"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.553 4.117 1.52 5.847L0 24l6.32-1.495A11.947 11.947 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.007-1.371l-.36-.213-3.727.881.896-3.624-.234-.373A9.818 9.818 0 112 12c0 5.42 4.4 9.818 10 9.818z"/>
      </svg>
      Consultar disponibilidad
    </a>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator animate-fadeIn animate-delay-800" aria-hidden="true">
    <div class="scroll-mouse">
      <div class="scroll-wheel"></div>
    </div>
    <span>Descubrí más</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Fondo */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transform: scale(1.05);
    animation: heroZoom 14s ease-out forwards;
  }

  @keyframes heroZoom {
    from { transform: scale(1.05); }
    to   { transform: scale(1); }
  }

  /* Overlay con degradado rico — más oscuro abajo para que el scroll indicator se lea */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      170deg,
      rgba(30, 18, 10, 0.72) 0%,
      rgba(90, 45, 18, 0.52) 50%,
      rgba(30, 18, 10, 0.78) 100%
    );
  }

  /* Contenido */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 800;
    color: white;
    line-height: 1.05;
    margin-bottom: 2.5rem;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.35);
    letter-spacing: -0.02em;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-arena);
    display: block;
  }

  .hero-btn {
    font-size: 1.0625rem;
    padding: 1.0625rem 2.5rem;
    box-shadow: 0 6px 28px rgba(184, 84, 48, 0.5);
  }

  /* Scroll indicator — fijado al fondo de la sección */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    animation: bounceY 2.2s ease-in-out infinite;
  }

  @keyframes bounceY {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }

  .scroll-mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 11px;
    display: flex;
    justify-content: center;
    padding-top: 5px;
  }

  .scroll-wheel {
    width: 3px;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.6);
    border-radius: 2px;
    animation: scrollWheel 1.5s ease-in-out infinite;
  }

  @keyframes scrollWheel {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(6px); opacity: 0.25; }
  }

  @media (max-width: 640px) {
    .hero-title { font-size: clamp(2.75rem, 11vw, 4rem); margin-bottom: 2rem; }
    .hero-btn { padding: 0.9375rem 2rem; font-size: 1rem; }
  }
</style>
