---
// Amenities Section — La Casa de Kuki
const amenities = [
  {
    icon: 'wifi',
    title: 'Wi-Fi gratis',
    description: 'Conexión estable para compartir tu viaje o seguir conectado en medio de la Quebrada.',
  },
  {
    icon: 'parking',
    title: 'Estacionamiento privado',
    description: 'Espacio propio y seguro dentro del predio, incluido durante toda tu estadía.',
  },
  {
    icon: 'bbq',
    title: 'Quincho con parrilla',
    description: 'Cocina completa y parrillero compartido a disposición para cocinar como en casa.',
  },
  {
    icon: 'infusions',
    title: 'Kit de infusiones',
    description: 'Pava eléctrica, vajilla e infusiones en tu departamento para prepararte un té o café cuando quieras.',
  },
  {
    icon: 'hotwater',
    title: 'Agua caliente',
    description: 'Baño privado equipado con toallas, amenities de aseo y agua caliente garantizada para cuando baje la temperatura.',
  },
  {
    icon: 'bedding',
    title: 'Ropa de cama y toallas',
    description: 'Incluye blancos de calidad, elementos de higiene personal y todo lo necesario para tu comodidad.',
  },
];

// SVGs como strings para inlining limpio
type IconKey = 'wifi' | 'parking' | 'bbq' | 'infusions' | 'hotwater' | 'bedding';

const icons: Record<IconKey, string> = {
  wifi: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/></svg>`,
  parking: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>`,
  bbq: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.1 13.34l2.83-2.83L3.91 3.5C2.35 5.06 2.35 7.62 3.91 9.17l4.19 4.17zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.2-1.1-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13l1.47-1.47z"/></svg>`,
  infusions: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z"/></svg>`,
  hotwater: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z"/></svg>`,
  bedding: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 9h-4V3H9v6H5c-1.66 0-3 1.34-3 3v8h2v-2h16v2h2v-8c0-1.66-1.34-3-3-3zM9 5h6v4H9V5zm11 9H4v-2c0-.55.45-1 1-1h14c.55 0 1 .45 1 1v2z"/></svg>`,
};
---

<section id="servicios" class="amenities-section">
  <!-- Franja decorativa superior -->
  <div class="amenities-strip" aria-hidden="true"></div>

  <div class="section-wrapper amenities-wrapper">
    <!-- Header -->
    <div class="amenities-header">
      <p class="amenities-eyebrow">Todo lo que necesitás</p>
      <h2 class="section-title">Servicios de<br /><em>la casa</em></h2>
      <div class="section-divider"><span>✦</span></div>
      <p class="section-subtitle">
        Lo que tiene la casa para que no te falte nada y pases unos días bien relajados.
      </p>
    </div>

    <!-- Grid de amenities -->
    <div class="amenities-grid amenities-grid--5" role="list">
      {amenities.map((amenity, index) => (
        <div class="amenity-card card" role="listitem" style={`animation-delay: ${index * 0.08}s`}>
          <div class="amenity-icon-wrap" aria-hidden="true">
            <Fragment set:html={icons[amenity.icon as IconKey]} />
          </div>
          <div class="amenity-body">
            <h3 class="amenity-title">{amenity.title}</h3>
            <p class="amenity-desc">{amenity.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animaciones de entrada con IntersectionObserver
  const cards = document.querySelectorAll('.amenity-card');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = '1';
          (entry.target as HTMLElement).style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  cards.forEach((card, i) => {
    (card as HTMLElement).style.opacity = '0';
    (card as HTMLElement).style.transform = 'translateY(24px)';
    (card as HTMLElement).style.transition = `opacity 0.5s ease ${i * 0.08}s, transform 0.5s ease ${i * 0.08}s`;
    observer.observe(card);
  });
</script>

<style>
  .amenities-section {
    background-color: var(--color-arena-light);
    padding-bottom: 6rem;
    position: relative;
  }

  .amenities-strip {
    height: 6px;
    background: linear-gradient(90deg, var(--color-terracota-dark), var(--color-terracota), var(--color-arena), var(--color-terracota), var(--color-terracota-dark));
    margin-bottom: 0;
  }

  .amenities-wrapper {
    padding-top: 5rem;
  }

  .amenities-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .amenities-eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-terracota);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-title em {
    font-style: italic;
    color: var(--color-terracota);
    display: block;
  }

  /* Grid */
  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .amenities-grid--5 {
    grid-template-columns: repeat(3, 1fr);
  }

  .amenities-grid--5 .amenity-card:nth-child(4),
  .amenities-grid--5 .amenity-card:nth-child(5) {
    /* Centrar las 2 últimas cards en la segunda fila */
  }

  .amenity-card {
    background: white;
    border-radius: 1.25rem;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid rgba(232, 213, 176, 0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: default;
  }

  .amenity-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(193, 96, 58, 0.14);
    border-color: var(--color-terracota-light);
  }

  .amenity-icon-wrap {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, var(--color-terracota) 0%, var(--color-terracota-dark) 100%);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(193, 96, 58, 0.3);
  }

  .amenity-body {
    flex: 1;
  }

  .amenity-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-marron-dark);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .amenity-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-carbon-light);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .amenities-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .amenities-grid { grid-template-columns: 1fr; }
  }
</style>
